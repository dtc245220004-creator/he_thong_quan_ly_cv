{
  "name": "task-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Starter project for a Task Tracker learning project",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node --env-file-if-exists=.env --watch backend/src/server.js",
    "dev:frontend": "node node_modules/vite/bin/vite.js frontend --config frontend/vite.config.js",
    "build": "node node_modules/vite/bin/vite.js build frontend --config frontend/vite.config.js",
    "lint": "node node_modules/oxlint/bin/oxlint frontend/src backend/src tests",
    "db:check": "node --env-file-if-exists=.env backend/src/check-db.js",
    "db:init": "node --env-file-if-exists=.env backend/src/init-db.js",
    "seed:demo": "node --env-file-if-exists=.env backend/src/seed-demo.js",
    "admin:create": "node --env-file-if-exists=.env backend/src/create-admin.js",
    "test": "node --test tests/backend-health.test.js tests/tasks-api.test.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/mysql-integration.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
