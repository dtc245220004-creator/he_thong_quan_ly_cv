PORT=3001
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=task_tracker
DB_PASSWORD=replace_with_a_unique_strong_application_password
DB_NAME=task_tracker
DB_MONITOR_USER=task_tracker_monitor
DB_MONITOR_PASSWORD=replace_with_a_unique_strong_metrics_password
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SAME_SITE=Lax

# PostgreSQL superuser, admin tools, and dashboards: use unique passwords.
POSTGRES_PASSWORD=replace_with_a_different_strong_database_admin_password
PGADMIN_DEFAULT_EMAIL=student@example.edu
PGADMIN_DEFAULT_PASSWORD=replace_with_a_unique_strong_pgadmin_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_unique_strong_grafana_password

# Optional: password reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
